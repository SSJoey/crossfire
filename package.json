{
  "name": "crossfire",
  "private": true,
  "type": "module",
  "workspaces": [
    "shared",
    "server",
    "client"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p client/tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "server": "npm run start -w server",
    "smoke:server": "tsx tools/smoke-server.ts",
    "dev": "node --run server & npm run dev -w client",
    "build": "npm run build -w client",
    "fetch-assets": "node tools/fetch-assets.mjs",
    "assets": "node tools/assets.mjs",
    "test:e2e": "playwright test",
    "bots": "tsx tools/bots/run.ts",
    "load-test": "tsx tools/load-test.ts",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.20.5",
    "@types/ws": "^8.18.2",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "meshoptimizer": "^1.3.0",
    "prettier": "3.9",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5",
    "ws": "^8.22.1",
    "yaml": "^2.9.1"
  }
}
